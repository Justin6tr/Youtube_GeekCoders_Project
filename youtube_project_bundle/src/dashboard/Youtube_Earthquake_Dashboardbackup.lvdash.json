{
  "datasets": [
    {
      "name": "b5b6f492",
      "displayName": "EarthQuake_Detail",
      "queryLines": [
        "select * from youtube_dev.silver.earthquake_data_final;\r\n",
        "\r\n"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "7c0b3273",
      "displayName": "EarthQuake_Country",
      "queryLines": [
        "\r\n",
        "  select count(*) as event_count,\r\n",
        "       case when size(split(place,',')) = 1 then split(place,',')[0] \r\n",
        "            else split(place,',')[1]\r\n",
        "       end as country\r\n",
        "    --  split(place,',')[1] as country\r\n",
        "from \r\n",
        "(select event_time,title,\r\n",
        "        magnitude,longitude,place\r\n",
        "from silver.earthquake_data_final)\r\n",
        "group by country;\r\n"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "71c6909d",
      "displayName": "EarthQuake_Type",
      "queryLines": [
        "\r\n",
        "\r\n",
        "SELECT\r\n",
        "  count(*) as total_magnitude_bucket ,\r\n",
        "  magnitude_bucket\r\n",
        "   from (\r\n",
        "select  \r\n",
        "  CASE\r\n",
        "    WHEN magnitude  < 2  THEN 'Micro (2)'\r\n",
        "    WHEN magnitude BETWEEN  2 AND  3 THEN 'Minor (2-3)'\r\n",
        "    WHEN magnitude BETWEEN  3 AND  4 THEN 'Light (3-4)'\r\n",
        "    ELSE 'Moderate+ (4+)'\r\n",
        "  END as magnitude_bucket\r\n",
        "FROM\r\n",
        "  youtube_dev.silver.earthquake_data_final\r\n",
        "   )\r\n",
        "GROUP BY\r\n",
        "  magnitude_bucket;\r\n",
        "\r\n",
        "\r\n"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
